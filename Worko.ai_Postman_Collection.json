{
  "info": {
    "_postman_id": "worko-ai-collection",
    "name": "Worko.ai Referral Management System",
    "description": "API Collection for Worko.ai - Candidate Referral Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Get All Candidates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates",
              "host": ["{{base_url}}"],
              "path": ["candidates"]
            }
          }
        },
        {
          "name": "Get Candidates with Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates?search=John&status=Pending",
              "host": ["{{base_url}}"],
              "path": ["candidates"],
              "query": [
                {
                  "key": "search",
                  "value": "John"
                },
                {
                  "key": "status",
                  "value": "Pending"
                }
              ]
            }
          }
        },
        {
          "name": "Get Candidate Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/stats",
              "host": ["{{base_url}}"],
              "path": ["candidates", "stats"]
            }
          }
        },
        {
          "name": "Create Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Jane Smith",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "jane@example.com",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "9876543210",
                  "type": "text"
                },
                {
                  "key": "jobTitle",
                  "value": "Software Engineer",
                  "type": "text"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/candidates",
              "host": ["{{base_url}}"],
              "path": ["candidates"]
            }
          }
        },
        {
          "name": "View Resume",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/candidates/{{candidate_id}}/resume",
              "host": ["{{base_url}}"],
              "path": ["candidates", "{{candidate_id}}", "resume"]
            }
          }
        },
        {
          "name": "Update Candidate Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Reviewed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/candidates/{{candidate_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["candidates", "{{candidate_id}}", "status"]
            }
          }
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/{{candidate_id}}",
              "host": ["{{base_url}}"],
              "path": ["candidates", "{{candidate_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "candidate_id",
      "value": "",
      "type": "string"
    }
  ]
}
